{
  "name": "insulhub-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prod-smoke:sales-report": "node scripts/prod-smoke-sales-report.cjs",
    "test:cloudflare": "vitest run --config cloudflare/vitest.config.mjs",
    "test:site-plan-drawings": "vitest run src/lib/site-plan-drawings.test.ts",
    "test:sms-replies": "vitest run src/lib/sms-reply-matching.test.ts",
    "cloudflare:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "test:communications": "node scripts/test-communication-settings.cjs && node scripts/test-communication-delivery.cjs && node scripts/test-communication-merge-fields.cjs",
    "test:partner": "vitest run src/lib/partner",
    "partner:migrate": "node scripts/partner-migrate.mjs",
    "partner:migrate:gate": "node scripts/partner-postgres-gate.mjs",
    "partner:live-test-once": "node --conditions=react-server --import tsx scripts/partner-live-test-once.ts",
    "partner:notification-test-once": "node --conditions=react-server --import tsx scripts/partner-notification-test-once.ts",
    "partner:provision": "node scripts/partner-provision.mjs",
    "test": "npm run test:site-plan-drawings && npm run test:sms-replies && npm run test:partner && npm run test:job-sms && npm run test:communications && npm run test:cloudflare && npm run test:job-email",
    "test:job-sms": "vitest run src/lib/job-sms*.test.*",
    "test:job-sms-browser": "node scripts/job-sms-browser-smoke.cjs",
    "job-sms:migrate": "node scripts/job-sms-migrate.mjs",
    "test:job-email": "vitest run src/lib/job-email*.test.* src/lib/job-communication-history.test.ts",
    "job-email:migrate": "node scripts/job-email-migrate.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "^1.6.24",
    "date-fns": "^4.1.0",
    "next": "16.1.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.0.1",
    "pg-mem": "^3.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
